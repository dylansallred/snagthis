{
  "name": "@m3u8/desktop",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dylansallred/snagthis.git"
  },
  "main": "electron/main.js",
  "description": "SnagThis Desktop",
  "author": {
    "name": "SnagThis",
    "url": "https://snagthisvid.com"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && node ./scripts/dev-electron.cjs",
    "fetch:yt-dlp": "node ./scripts/fetch-yt-dlp.cjs",
    "fetch:ffmpeg": "node ./scripts/fetch-ffmpeg.cjs",
    "build": "vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@m3u8/contracts": "1.0.0",
    "@m3u8/downloader-api": "1.0.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "electron": "44.4.5",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.snagthisvid.desktop",
    "productName": "SnagThis",
    "extraMetadata": {
      "name": "SnagThis",
      "productName": "SnagThis"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "dylansallred",
        "repo": "snagthis",
        "private": false
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "sign": true
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "protocols": [
      {
        "name": "SnagThis",
        "schemes": [
          "snagthis"
        ]
      }
    ]
  },
  "license": "GPL-3.0-only"
}
