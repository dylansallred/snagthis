{
  "name": "vidsnag",
  "private": true,
  "version": "2.0.0",
  "description": "Electron desktop app + Chrome extension for m3u8 downloading",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace @m3u8/desktop",
    "build:desktop": "npm run build --workspace @m3u8/desktop",
    "pack:desktop": "npm run pack --workspace @m3u8/desktop",
    "dist:desktop": "npm run dist --workspace @m3u8/desktop",
    "release:preflight": "./scripts/release-preflight.sh",
    "release:tag": "./scripts/release-tag.sh",
    "build:extension:css": "npm run sync:extension && npm run build:css --workspace @m3u8/extension",
    "dev:extension:css": "npm run dev:css --workspace @m3u8/extension",
    "package:extension": "npm run build:extension:css && node scripts/package-extension.cjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --cache --cache-location .eslintcache",
    "lint:fix": "npm run lint -- --fix",
    "typecheck:desktop": "tsc --noEmit --project apps/desktop/tsconfig.json",
    "test": "node --test --test-force-exit tests/*.test.js",
    "test:e2e": "playwright test",
    "dev": "npm run dev:desktop",
    "build": "npm run build:extension:css && npm run build:desktop",
    "sync:extension": "node scripts/sync-extension-shared.cjs",
    "test:media": "node --test tests/media-fixtures.test.js",
    "check:tokens": "node scripts/check-tokens.cjs",
    "compat": "node compat/run.js",
    "verify": "npm run lint && npm run typecheck:desktop && npm test && npm run build && npm run check:tokens"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.55.1",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "js-yaml": "^4.3.2",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "license": "GPL-3.0-only"
}
