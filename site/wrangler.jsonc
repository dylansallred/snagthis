// Cloudflare Workers static site for snagthisvid.com. No build step: the files in this
// folder are served as-is. _headers sets security and caching headers, /privacy serves
// privacy.html, and unknown paths get 404.html with a 404 status.
{
  "name": "snagthis",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Cloudflare's preview builds (for pull requests) run `wrangler preview`, which needs this block.
  "previews": {}
}
